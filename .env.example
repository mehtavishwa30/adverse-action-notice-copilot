# ---------------------------------------------------------------------------
# Langfuse  —  https://cloud.langfuse.com  (Settings -> API Keys)
# ---------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY="pk-lf-..."
LANGFUSE_SECRET_KEY="sk-lf-..."
# EU: https://cloud.langfuse.com  |  US: https://us.cloud.langfuse.com
# JP: https://jp.cloud.langfuse.com |  HIPAA: https://hipaa.cloud.langfuse.com
# Self-hosted: http://localhost:3000
LANGFUSE_BASE_URL="https://cloud.langfuse.com"

# ---------------------------------------------------------------------------
# OpenAI  —  https://platform.openai.com/api-keys
# ---------------------------------------------------------------------------
OPENAI_API_KEY="sk-proj-..."

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Tags every trace/score so demo data is separable from real traffic.
LANGFUSE_TRACING_ENVIRONMENT="demo"
# Rehearse the whole pipeline with no OpenAI key and no spend.
# MOCK_LLM=1
# Redact SSNs, account numbers and emails before spans are exported.
# LANGFUSE_MASK_PII=1
# Quieten or expand Langfuse SDK logging: DEBUG | INFO | WARN | ERROR
# LANGFUSE_LOG_LEVEL=WARN
